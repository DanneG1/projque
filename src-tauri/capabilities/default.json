{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal surface. App-defined commands only; no plugin IPC is exposed to the webview.",
  "windows": ["main", "session-*"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:webview:default",
    "core:window:default"
  ]
}
